rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    // Store products are readable by the public; only signed-in admin custom claims can write.
    function isAdmin() { return signedIn() && request.auth.token.admin == true; }

    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    match /promos/{promoId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    // Customers may create orders, but cannot read arbitrary customer orders.
    // Production should add strict field validation, App Check, rate limits, and server-side stock transactions.
    match /orders/{orderId} {
      allow create: if request.resource.data.keys().hasAll(['name','phone','items','total','status','createdAt'])
                    && request.resource.data.status == 'new'
                    && request.resource.data.name is string
                    && request.resource.data.phone is string;
      allow read, update, delete: if isAdmin();
    }
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
