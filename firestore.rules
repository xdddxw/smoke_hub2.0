rules_version = '2'; service cloud.firestore { match /databases/{database}/documents {
// Перевірка, чи користувач є авторизованим адміном
function isAdmin() {
  return request.auth != null;
}

// Правила для каталогу товарів
match /products/{productId} {
  allow read: if true; // Всі можуть переглядати каталог
  allow write: if isAdmin(); // Тільки адмін може додавати/редагувати/видаляти товари
}

// Правила для замовлень
match /orders/{orderId} {
  allow read: if isAdmin() || (resource != null && resource.data.userId == request.auth.uid);
  
  // Клієнти можуть створювати замовлення тільки зі статусом 'pending'
  allow create: if request.resource.data.status == 'pending';
  
  // Тільки адмін може змінювати статус замовлення (підтверджувати/скасовувати)
  allow update, delete: if isAdmin();
}
} }
